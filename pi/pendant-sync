#!/usr/bin/env bash
# Pull new recordings off the pendant, file them by date, and free only those pages on the pendant.
# Run it as `pendant sync`; the pendant-sync timer does that every 15 minutes.
set -euo pipefail

# Settings saved by install-sync.sh; anything already set in the shell wins.
if [ -f "$HOME/.config/pendant/env" ]; then
  saved_address=$(sed -n 's/^PENDANT_ADDRESS=//p' "$HOME/.config/pendant/env")
  saved_bin=$(sed -n 's/^PENDANT_BIN=//p' "$HOME/.config/pendant/env")
  PENDANT_ADDRESS="${PENDANT_ADDRESS:-$saved_address}"
  PENDANT_BIN="${PENDANT_BIN:-$saved_bin}"
  export PENDANT_ADDRESS
fi
PENDANT="${PENDANT_BIN:-$(command -v pendant || echo "$HOME/.local/bin/pendant")}"
ARCHIVE="${PENDANT_ARCHIVE:-$HOME/recordings}"
INCOMING="$ARCHIVE/.incoming"
export PYTHONUNBUFFERED=1

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*"; }

if [ -z "${PENDANT_ADDRESS:-}" ]; then
  log "PENDANT_ADDRESS isn't set. Put it in ~/.config/pendant/env (PENDANT_ADDRESS=AA:BB:CC:DD:EE:FF)."
  exit 1
fi

mkdir -p "$INCOMING"

# Keep a plain log next to the recordings (last ~2000 lines), as well as the systemd journal.
LOG="$ARCHIVE/sync.log"
if [ -f "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 4000 ]; then
  tail -n 2000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi
exec > >(tee -a "$LOG") 2>&1

# One sync at a time.
exec 9>"$ARCHIVE/.sync.lock"
if ! flock -n 9; then
  log "A sync is already running; skipping."
  exit 0
fi

# Out of range or asleep: skip quietly and try again next time.
if ! timeout 45 "$PENDANT" status >/dev/null 2>&1; then
  log "Pendant not reachable; skipping."
  exit 0
fi

# Anything left in .incoming from an interrupted run gets filed first.
file_incoming() {
  local f day
  for f in "$INCOMING"/pendant_*; do
    [ -e "$f" ] || continue
    day=$(basename "$f" | sed -E 's/^pendant_([0-9]{4})([0-9]{2})([0-9]{2})_.*/\1-\2-\3/')
    case "$day" in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
      *) day="undated" ;;
    esac
    mkdir -p "$ARCHIVE/$day"
    target="$ARCHIVE/$day/$(basename "$f")"
    if [ -e "$target" ]; then
      # Same start time: pages that weren't freed last time were downloaded again, with
      # anything newer. The new copy holds everything the old one did, so it replaces it,
      # and the transcript is redone.
      base="${target%.*}"
      rm -f "$base.txt" "$base.words.json"
      case "$target" in *.opus) log "Replacing $(basename "$base") with a newer, longer download of the same recording" ;; esac
    fi
    mv -f "$f" "$ARCHIVE/$day/"
  done
}
file_incoming

log "Syncing from $PENDANT_ADDRESS"
cd "$INCOMING"
timeout 1200 "$PENDANT" download --decode --delete-after -o "$INCOMING"
file_incoming
log "Done. Recordings are in $ARCHIVE"
