@@ -0,0 +1,76 @@
+"""`pendant sync` hands off to the installed sync script."""
+
+import os
+import stat
+
+from click.testing import CliRunner
+
+from pendant.cli import cli
+
+
+def test_sync_missing_script(tmp_path, monkeypatch):
+    monkeypatch.setenv("PENDANT_SYNC_SCRIPT", str(tmp_path / "nope"))
+    result = CliRunner().invoke(cli, ["sync"])
+    assert result.exit_code != 0
+    assert "isn't installed" in result.output
+
+
+def test_sync_runs_script_with_address(tmp_path, monkeypatch):
+    script = tmp_path / "pendant-sync"
+    script.write_text("#!/bin/sh\n")
+    script.chmod(script.stat().st_mode | stat.S_IEXEC)
+    monkeypatch.setenv("PENDANT_SYNC_SCRIPT", str(script))
+    calls = []
+    monkeypatch.setattr(os, "execve", lambda path, argv, env: calls.append((path, env)))
+    result = CliRunner().invoke(cli, ["-a", "AA:BB:CC:DD:EE:FF", "sync"])
+    assert result.exit_code == 0, result.output
+    assert calls[0][0] == str(script)
+    assert calls[0][1]["PENDANT_ADDRESS"] == "AA:BB:CC:DD:EE:FF"
+
+
+def test_backup_runs_its_script(tmp_path, monkeypatch):
+    script = tmp_path / "pendant-backup"
+    script.write_text("#!/bin/sh\n")
+    script.chmod(script.stat().st_mode | stat.S_IEXEC)
+    monkeypatch.setenv("PENDANT_BACKUP_SCRIPT", str(script))
+    calls = []
+    monkeypatch.setattr(os, "execve", lambda path, argv, env: calls.append(path))
+    result = CliRunner().invoke(cli, ["backup"])
+    assert result.exit_code == 0, result.output
+    assert calls == [str(script)]
+
+
+def test_transcribe_passes_its_options_through(tmp_path, monkeypatch):
+    py, script = tmp_path / "python", tmp_path / "pendant-transcribe.py"
+    py.write_text(""); script.write_text("")
+    monkeypatch.setenv("PENDANT_WHISPER_PYTHON", str(py))
+    monkeypatch.setenv("PENDANT_TRANSCRIBE_SCRIPT", str(script))
+    calls = []
+    monkeypatch.setattr(os, "execv", lambda path, argv: calls.append(argv))
+    for extra in (["--limit", "1"], ["--help"], []):
+        calls.clear()
+        result = CliRunner().invoke(cli, ["transcribe", *extra])
+        assert result.exit_code == 0, result.output
+        assert calls == [[str(py), str(script), *extra]]
+
+
+def test_transcribe_not_installed(tmp_path, monkeypatch):
+    monkeypatch.setenv("PENDANT_WHISPER_PYTHON", str(tmp_path / "nope"))
+    result = CliRunner().invoke(cli, ["transcribe"])
+    assert result.exit_code != 0 and "install-transcribe.sh" in result.output
+
+
+def test_backup_check_passes_the_flag(tmp_path, monkeypatch):
+    import os
+    from click.testing import CliRunner
+    from pendant.cli import cli
+    script = tmp_path / "pendant-backup"
+    script.write_text("#!/bin/sh\n")
+    script.chmod(0o755)
+    monkeypatch.setenv("PENDANT_BACKUP_SCRIPT", str(script))
+    seen = {}
+    monkeypatch.setattr(os, "execve", lambda path, argv, env: seen.update(argv=argv))
+    CliRunner().invoke(cli, ["backup", "--check"])
+    assert seen["argv"] == [str(script), "--check"]
+    CliRunner().invoke(cli, ["backup"])
+    assert seen["argv"] == [str(script)]
