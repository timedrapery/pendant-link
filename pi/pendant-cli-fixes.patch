--- /dev/null
+++ b/src/pendant/commands/sync.py
@@ -0,0 +1,26 @@
+"""`pendant sync`: pull new recordings, file them by date, free only what was saved.
+
+Runs the sync script that install-sync.sh puts in ~/.local/share/pendant/.
+"""
+
+import os
+from pathlib import Path
+
+import click
+
+DEFAULT_SCRIPT = Path.home() / ".local" / "share" / "pendant" / "pendant-sync"
+
+
+@click.command()
+@click.pass_context
+def sync(ctx):
+    """Pull new recordings into ~/recordings/<date>/ and free them on the pendant."""
+    script = Path(os.environ.get("PENDANT_SYNC_SCRIPT", DEFAULT_SCRIPT))
+    if not script.is_file():
+        raise click.ClickException(
+            f"Sync isn't installed ({script} is missing). Run install-sync.sh first."
+        )
+    env = dict(os.environ)
+    if ctx.obj.get("address"):
+        env["PENDANT_ADDRESS"] = ctx.obj["address"]
+    os.execve(str(script), [str(script)], env)
diff --git a/src/pendant/core/audiocrypto.py b/src/pendant/core/audiocrypto.py
new file mode 100644
index 0000000..536d62c
--- /dev/null
+++ b/src/pendant/core/audiocrypto.py
@@ -0,0 +1,129 @@
+"""Audio encryption, matching the Limitless app (index.android.bundle, v2.1.6).
+
+The pendant holds its own P-256 key pair and reports the public half in
+DeviceInfoMsg.device_audio_encryption_pub_key. The app makes a second P-256
+key pair (it calls it the "server" key), sends the pendant the raw 65-byte
+public key with SetServerPublicKey, and both sides derive the same AES key:
+
+    shared  = ECDH-P256(our private key, pendant public key)    # 32 bytes
+    aes_key = HKDF-SHA256(shared, salt=b"", info=b"", length=16) # AES-128-GCM
+
+Each audio chunk then arrives as EncryptedBytes {ciphertext, nonce, tag}.
+
+Files, in KEYS_DIR (default ~/.config/pendant/keys):
+    server_private.pem   our P-256 private key (PKCS#8, owner-only)
+    server_public.bin    our raw public key, the bytes sent to the pendant
+    device_public.bin    the pendant's raw public key at the time of setkey
+    audio.key            the derived 16-byte AES key (owner-only)
+
+audio.key alone is enough to decrypt. Losing it means recordings still on the
+pendant can't be read, so back it up.
+"""
+
+from pathlib import Path
+from typing import Optional
+
+from .config import KEYS_DIR
+
+PRIVATE_FILE = "server_private.pem"
+PUBLIC_FILE = "server_public.bin"
+DEVICE_FILE = "device_public.bin"
+AUDIO_KEY_FILE = "audio.key"
+
+
+def _keys_dir(keys_dir: Optional[Path]) -> Path:
+    return Path(keys_dir) if keys_dir else KEYS_DIR
+
+
+def _write_private(path: Path, data: bytes):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.touch(mode=0o600, exist_ok=True)
+    path.chmod(0o600)
+    path.write_bytes(data)
+
+
+def generate_keypair(keys_dir: Optional[Path] = None, force: bool = False) -> bytes:
+    """Make our P-256 key pair. Returns the raw public key. Won't overwrite unless forced."""
+    from cryptography.hazmat.primitives import serialization
+    from cryptography.hazmat.primitives.asymmetric import ec
+
+    d = _keys_dir(keys_dir)
+    private_path = d / PRIVATE_FILE
+    if private_path.exists() and not force:
+        raise FileExistsError(str(private_path))
+
+    key = ec.generate_private_key(ec.SECP256R1())
+    pem = key.private_bytes(
+        serialization.Encoding.PEM,
+        serialization.PrivateFormat.PKCS8,
+        serialization.NoEncryption(),
+    )
+    public_raw = key.public_key().public_bytes(
+        serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint
+    )
+    _write_private(private_path, pem)
+    (d / PUBLIC_FILE).write_bytes(public_raw)
+    return public_raw
+
+
+def load_public_raw(keys_dir: Optional[Path] = None) -> Optional[bytes]:
+    p = _keys_dir(keys_dir) / PUBLIC_FILE
+    return p.read_bytes() if p.exists() else None
+
+
+def parse_device_public_key(raw: bytes):
+    """Validate the pendant's public key; raises ValueError if it isn't a P-256 point."""
+    from cryptography.hazmat.primitives.asymmetric import ec
+
+    if len(raw) != 65 or raw[0] != 0x04:
+        raise ValueError(f"expected a 65-byte uncompressed P-256 key, got {len(raw)} bytes")
+    return ec.EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), raw)
+
+
+def derive_audio_key(private_key, device_public_raw: bytes) -> bytes:
+    """ECDH-P256 then HKDF-SHA256 (empty salt and info) to a 16-byte AES key."""
+    from cryptography.hazmat.primitives import hashes
+    from cryptography.hazmat.primitives.asymmetric import ec
+    from cryptography.hazmat.primitives.kdf.hkdf import HKDF
+
+    shared = private_key.exchange(ec.ECDH(), parse_device_public_key(device_public_raw))
+    return HKDF(algorithm=hashes.SHA256(), length=16, salt=b"", info=b"").derive(shared)
+
+
+def save_audio_key(device_public_raw: bytes, keys_dir: Optional[Path] = None) -> bytes:
+    """Derive the AES key for this pendant from our saved private key, and save it."""
+    from cryptography.hazmat.primitives import serialization
+
+    d = _keys_dir(keys_dir)
+    private_key = serialization.load_pem_private_key((d / PRIVATE_FILE).read_bytes(), password=None)
+    key = derive_audio_key(private_key, device_public_raw)
+    (d / DEVICE_FILE).write_bytes(device_public_raw)
+    _write_private(d / AUDIO_KEY_FILE, key)
+    return key
+
+
+def load_audio_key(keys_dir: Optional[Path] = None) -> Optional[bytes]:
+    p = _keys_dir(keys_dir) / AUDIO_KEY_FILE
+    if not p.exists():
+        return None
+    key = p.read_bytes()
+    return key if len(key) == 16 else None
+
+
+def decrypt_chunk(key: bytes, nonce: bytes, ciphertext: bytes, tag: bytes) -> Optional[bytes]:
+    """AES-128-GCM. Returns None if the tag doesn't verify (wrong key or damaged data)."""
+    from cryptography.exceptions import InvalidTag
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+    try:
+        return AESGCM(key).decrypt(nonce, ciphertext + tag, None)
+    except (InvalidTag, ValueError):
+        return None
+
+
+def encrypt_chunk(key: bytes, nonce: bytes, plaintext: bytes) -> tuple:
+    """The pendant's side, for tests: returns (ciphertext, tag)."""
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+    out = AESGCM(key).encrypt(nonce, plaintext, None)
+    return out[:-16], out[-16:]
