new file mode 100644
index 0000000..9c21660
--- /dev/null
+++ b/tests/test_sync_safety.py
@@ -0,0 +1,88 @@
+"""Safety tests for freeing pages on the pendant after a download."""
+import click
+import pytest
+
+from pendant.core.protocol import PendantProtocol, safe_delete_index
+from pendant.core.proto import pb
+from pendant.commands.audio import _save_and_free
+
+
+def test_safe_delete_index_contiguous():
+    assert safe_delete_index([5, 6, 7]) == 7
+
+
+def test_safe_delete_index_stops_before_gap():
+    # page 7 never arrived: deleting "through 9" would destroy it
+    assert safe_delete_index([5, 6, 8, 9]) == 6
+
+
+def test_safe_delete_index_unordered_and_duplicates():
+    assert safe_delete_index([9, 7, 8, 7, 10]) == 10
+
+
+def test_safe_delete_index_empty():
+    assert safe_delete_index([]) is None
+
+
+def test_delete_command_encoding():
+    raw = PendantProtocol().create_command("delete_flash_page", index=1234)
+    env = pb.BLEMessageFromNativeToPendant()
+    env.ParseFromString(raw)
+    cmd = pb.ServerCommandMsg()
+    cmd.ParseFromString(env.payload)
+    assert cmd.WhichOneof("content") == "delete_flash_page"
+    assert cmd.delete_flash_page.older_than_or_equal_to_index == 1234
+
+
+class FakeClient:
+    def __init__(self, indices, opus=b"\x01" * 50):
+        self.page_count = len(indices)
+        self.page_indices = list(indices)
+        self.page_errors = 0
+        self.opus_data = bytearray(opus)
+        self.pcm_data = bytearray()
+        self.encrypted_data = bytearray()
+        self.page_timestamps = [{"absolute_timestamp_ms": 1760118000000 + i, "boot_uptime_ms": 0, "chunks": []}
+                                for i in range(len(indices))]
+        self.sent = []
+
+    def send_command(self, name, **kw):
+        self.sent.append((name, kw))
+
+    def run_with_timeout(self, seconds):
+        pass
+
+
+def test_saves_file_then_frees_through_contiguous_end(tmp_path):
+    c = FakeClient([100, 101, 102])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert list(tmp_path.glob("pendant_*.opus"))
+    assert c.sent == [("delete_flash_page", {"index": 102})]
+
+
+def test_gap_limits_deletion(tmp_path):
+    c = FakeClient([100, 101, 103])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 101})]
+
+
+def test_no_delete_without_flag(tmp_path):
+    c = FakeClient([100, 101])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=False)
+    assert c.sent == []
+
+
+def test_nothing_downloaded_deletes_nothing(tmp_path):
+    c = FakeClient([], opus=b"")
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_failed_save_deletes_nothing(tmp_path, monkeypatch):
+    from pathlib import Path
+    c = FakeClient([1, 2, 3])
+    real = Path.write_bytes
+    monkeypatch.setattr(Path, "write_bytes", lambda self, data: real(self, b""))  # simulate an empty write
+    with pytest.raises(click.ClickException):
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
