+"""Audio encryption: the Limitless app's scheme, and never freeing what we can't read."""
+
+import json
+import os
+
+import pytest
+from click.testing import CliRunner
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.hazmat.primitives.kdf.hkdf import HKDF
+
+from pendant.core import audiocrypto
+from pendant.core.protocol import PendantProtocol, pb
+from pendant.commands.audio import _save_and_free
+from pendant.commands.crypto import decrypt
+
+from test_sync_safety import FakeClient
+
+
+def _raw(pub):
+    return pub.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
+
+
+@pytest.fixture
+def pendant_and_keys(tmp_path):
+    """A fake pendant key pair, plus our key pair and audio key in tmp_path."""
+    device = ec.generate_private_key(ec.SECP256R1())
+    ours_raw = audiocrypto.generate_keypair(keys_dir=tmp_path)
+    key = audiocrypto.save_audio_key(_raw(device.public_key()), keys_dir=tmp_path)
+    return device, ours_raw, key
+
+
+def _pendant_side_key(device, ours_raw):
+    """What the pendant computes from our public key."""
+    ours = ec.EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), ours_raw)
+    shared = device.exchange(ec.ECDH(), ours)
+    return HKDF(algorithm=hashes.SHA256(), length=16, salt=None, info=b"").derive(shared)
+
+
+def test_both_sides_derive_the_same_key(pendant_and_keys):
+    device, ours_raw, key = pendant_and_keys
+    assert len(ours_raw) == 65 and ours_raw[0] == 0x04
+    assert len(key) == 16
+    # salt=None (RFC 5869 zeros) must equal the app's empty salt
+    assert _pendant_side_key(device, ours_raw) == key
+
+
+def test_key_files_are_private(tmp_path, pendant_and_keys):
+    for name in (audiocrypto.PRIVATE_FILE, audiocrypto.AUDIO_KEY_FILE):
+        assert oct((tmp_path / name).stat().st_mode & 0o777) == "0o600"
+    assert audiocrypto.load_audio_key(keys_dir=tmp_path) == pendant_and_keys[2]
+
+
+def test_keygen_wont_overwrite(tmp_path, pendant_and_keys):
+    with pytest.raises(FileExistsError):
+        audiocrypto.generate_keypair(keys_dir=tmp_path)
+
+
+def test_rejects_wrong_kind_of_device_key():
+    with pytest.raises(ValueError):
+        audiocrypto.parse_device_public_key(os.urandom(32))  # an X25519-sized key
+    with pytest.raises(ValueError):
+        audiocrypto.parse_device_public_key(b"\x04" + b"\x00" * 64)  # not on the curve
+
+
+def _page(key, chunks):
+    page = pb.FlashPage(absolute_timestamp_ms=1760118000000)
+    for plaintext in chunks:
+        nonce = os.urandom(12)
+        ct, tag = audiocrypto.encrypt_chunk(key, nonce, plaintext)
+        c = page.chunks.add()
+        c.audio_data.encrypted_codec_beamforming_data.ciphertext = ct
+        c.audio_data.encrypted_codec_beamforming_data.nonce = nonce
+        c.audio_data.encrypted_codec_beamforming_data.tag = tag
+    return page.SerializeToString()
+
+
+def test_decrypts_pendant_audio(pendant_and_keys):
+    _, _, key = pendant_and_keys
+    proto = PendantProtocol()
+    opus, _, enc, _, _ = proto.extract_audio_from_flash_page(_page(key, [b"hello ", b"world"]), key)
+    assert opus == b"hello world"
+    assert enc == b"" and proto.undecrypted == []
+
+
+def test_wrong_key_keeps_chunks_whole(pendant_and_keys):
+    _, _, key = pendant_and_keys
+    proto = PendantProtocol()
+    opus, _, enc, _, _ = proto.extract_audio_from_flash_page(_page(key, [b"secret"]), os.urandom(16))
+    assert opus == b""
+    assert len(proto.undecrypted) == 1
+    rec = proto.undecrypted[0]
+    assert set(rec) >= {"nonce", "ciphertext", "tag"}
+
+
+def test_no_key_keeps_chunks_whole(pendant_and_keys):
+    _, _, key = pendant_and_keys
+    proto = PendantProtocol()
+    proto.extract_audio_from_flash_page(_page(key, [b"a", b"b"]), None)
+    assert len(proto.undecrypted) == 2
+
+
+def test_undecryptable_audio_is_never_freed(tmp_path, pendant_and_keys):
+    _, _, key = pendant_and_keys
+    c = FakeClient([100, 101, 102], opus=b"")
+    c.protocol = PendantProtocol()
+    c.protocol.extract_audio_from_flash_page(_page(key, [b"x" * 40]), None)
+    c.encrypted_data = bytearray(b"x")
+    c.private_key = None
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []  # nothing deleted
+    saved = list(tmp_path.glob("*.enc.jsonl"))
+    assert len(saved) == 1
+
+
+def test_saved_chunks_decrypt_later(tmp_path, pendant_and_keys, monkeypatch):
+    _, _, key = pendant_and_keys
+    proto = PendantProtocol()
+    proto.extract_audio_from_flash_page(_page(key, [b"first ", b"second"]), None)
+    enc = tmp_path / "pendant_20261010_120000.enc.jsonl"
+    enc.write_text("".join(json.dumps(r) + "\n" for r in proto.undecrypted))
+    result = CliRunner().invoke(decrypt, [str(enc), "--key", str(tmp_path / audiocrypto.AUDIO_KEY_FILE)])
+    assert result.exit_code == 0, result.output
+    assert (tmp_path / "pendant_20261010_120000.opus").read_bytes() == b"first second"
+
+
+def test_set_key_command_sends_raw_public_key(pendant_and_keys):
+    _, ours_raw, _ = pendant_and_keys
+    proto = PendantProtocol()
+    env = pb.BLEMessageFromNativeToPendant()
+    env.ParseFromString(proto.create_command("set_server_public_key", public_key=ours_raw))
+    cmd = pb.ServerCommandMsg()
+    cmd.ParseFromString(env.payload)
+    assert cmd.WhichOneof("content") == "set_audio_encryption_server_public_key"
+    assert cmd.set_audio_encryption_server_public_key.public_key == ours_raw
+    assert cmd.request_data.request_id == proto.message_index
+
+
+def _reply(error=None):
+    msg = pb.PendantAllMsg()
+    msg.response_data.request_id = 7
+    if error:
+        msg.response_data.error.category = 2
+        msg.response_data.error.error_message = error
+    return msg.SerializeToString()
+
+
+def test_reply_success_and_error():
+    proto = PendantProtocol()
+    ok = proto.parse_response(_reply())
+    assert ok["request_id"] == 7 and ok["response_success"] is True
+    bad = proto.parse_response(_reply("bad key"))
+    assert bad["response_success"] is False and bad["response_error"] == "bad key"
+
+
+def test_encrypted_bytes_wire_layout_matches_app():
+    """Field 1 nonce, 2 ciphertext, 3 tag, 4 packet offsets (FlashPageProto$EncryptedBytes)."""
+    e = pb.EncryptedBytes(nonce=b"N" * 12, ciphertext=b"C" * 5, tag=b"T" * 16, packet_offsets=[0, 3])
+    raw = e.SerializeToString()
+    assert raw.startswith(b"\x0a\x0c" + b"N" * 12 + b"\x12\x05" + b"C" * 5 + b"\x1a\x10" + b"T" * 16)
+    assert raw.endswith(b"\x22\x02\x00\x03")  # packed repeated int32
+
+
+def test_recovers_file_saved_with_swapped_fields(tmp_path, pendant_and_keys):
+    _, _, key = pendant_and_keys
+    lines = []
+    for pt in (b"one ", b"two"):
+        nonce = os.urandom(12)
+        ct, tag = audiocrypto.encrypt_chunk(key, nonce, pt)
+        # how the old version saved it: names swapped, no "layout"
+        lines.append(json.dumps({"page_index": 1, "nonce": ct.hex(), "ciphertext": nonce.hex(), "tag": tag.hex()}))
+    enc = tmp_path / "pendant_20261010_125315.enc.jsonl"
+    enc.write_text("\n".join(lines) + "\n")
+    result = CliRunner().invoke(decrypt, [str(enc), "--key", str(tmp_path / audiocrypto.AUDIO_KEY_FILE)])
+    assert result.exit_code == 0, result.output
+    assert (tmp_path / "pendant_20261010_125315.opus").read_bytes() == b"one two"
