+def export_text(d: Path) -> str:
+    import base64
+    import hashlib
+    import textwrap
+    blob = _keys_archive(d)
+    names = sorted(str(f.relative_to(d)) for f in d.rglob("*") if f.is_file())
+    keys = audiocrypto.load_all_audio_keys(d)
+    lines = [BEGIN,
+             f"made: {time.strftime('%Y-%m-%d %H:%M')} on this Pi",
+             f"audio key id: {audiocrypto.key_id(keys[0]) if keys else 'none'}"
+             + (f" (and {len(keys) - 1} earlier)" if len(keys) > 1 else ""),
+             f"files: {', '.join(names)}",
+             f"sha256: {hashlib.sha256(blob).hexdigest()}",
+             ""]
+    lines += textwrap.wrap(base64.b64encode(blob).decode(), 76)
+    lines.append(END)
+    return "\n".join(lines) + "\n"
