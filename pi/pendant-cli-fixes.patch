+def import_archive(blob: bytes, d: Path, force=False):
+    """Put exported keys back. Never overwrites a different existing key unless forced, and
+    then keeps the replaced one in previous/. Returns the list of files written."""
+    import io
+    import tarfile
+    with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tar:
+        members = tar.getmembers()
+        for m in members:
+            p = Path(m.name)
+            if not m.isfile() or p.is_absolute() or ".." in p.parts:
+                raise ValueError(f"unexpected entry {m.name!r}; nothing was changed")
+        clashes = [m.name for m in members
+                   if (d / m.name).exists() and (d / m.name).read_bytes() != tar.extractfile(m).read()]
+        if clashes and not force:
+            raise FileExistsError(", ".join(clashes))
+        if clashes:
+            audiocrypto.preserve_current_keys(d)
+        d.mkdir(parents=True, exist_ok=True)
+        d.chmod(0o700)
+        written = []
+        for m in members:
+            dest = d / m.name
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            dest.parent.chmod(0o700)
+            data = tar.extractfile(m).read()
+            dest.touch(mode=0o600, exist_ok=True)
+            dest.chmod(0o600)
+            dest.write_bytes(data)
+            written.append(m.name)
+    return written
