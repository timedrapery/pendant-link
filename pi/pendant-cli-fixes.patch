+def build_timeline(pages, frame_map, sample_rate=16000):
+    """[[seconds into the .wav, clock time in ms], ...] at the start of each audio chunk.
+
+    The pendant records only while it hears speech, so a recording is stretches with gaps
+    between them. Each chunk carries its own clock time; this lines those up with the
+    decoded audio, so a moment in the .wav can be given its real time of day.
+    """
+    import bisect
+    offsets = [o for o, _ in frame_map]
+    timeline = []
+    for page in pages:
+        base_ts = page.get("absolute_timestamp_ms", 0)
+        base_bytes = page.get("audio_offset_bytes")
+        if not base_ts or base_ts < 1577836800000 or base_bytes is None:
+            continue
+        for chunk in page.get("chunks", []):
+            byte_pos = base_bytes + chunk.get("audio_offset_bytes", 0)
+            i = bisect.bisect_left(offsets, byte_pos)
+            if i >= len(frame_map):
+                continue
+            seconds = frame_map[i][1] / sample_rate
+            wall = base_ts + chunk.get("time_offset_ms", 0)
+            if timeline and seconds <= timeline[-1][0]:
+                continue  # same spot in the audio (e.g. a chunk without sound)
+            timeline.append([round(seconds, 3), wall])
+    return timeline
