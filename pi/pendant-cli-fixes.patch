+"""Safety tests for freeing pages on the pendant after a download."""
+import click
+import pytest
+
+from pendant.core.protocol import PendantProtocol, safe_delete_index
+from pendant.core.proto import pb
+from pendant.commands.audio import _save_and_free
+
+
+def test_safe_delete_index_contiguous():
+    assert safe_delete_index([5, 6, 7]) == 7
+
+
+def test_safe_delete_index_stops_before_gap():
+    # page 7 never arrived: deleting "through 9" would destroy it
+    assert safe_delete_index([5, 6, 8, 9]) == 6
+
+
+def test_safe_delete_index_unordered_and_duplicates():
+    assert safe_delete_index([9, 7, 8, 7, 10]) == 10
+
+
+def test_safe_delete_index_empty():
+    assert safe_delete_index([]) is None
+
+
+def test_delete_command_encoding():
+    raw = PendantProtocol().create_command("delete_flash_page", index=1234)
+    env = pb.BLEMessageFromNativeToPendant()
+    env.ParseFromString(raw)
+    cmd = pb.ServerCommandMsg()
+    cmd.ParseFromString(env.payload)
+    assert cmd.WhichOneof("content") == "delete_flash_page"
+    assert cmd.delete_flash_page.older_than_or_equal_to_index == 1234
+
+
+_UNSET = object()
+
+
+class FakeClient:
+    def __init__(self, indices, opus=b"\x01" * 50, oldest=_UNSET, bad=()):
+        if oldest is _UNSET:  # by default the pendant reports the first page we got
+            oldest = min(indices) if len(list(indices)) else None
+        self.page_count = len(indices)
+        self.page_indices = list(indices)
+        self.page_errors = len(bad)
+        self.bad_page_indices = list(bad)
+        self.device_info = {"oldest_flash_page": oldest, "newest_flash_page": 99999} if oldest is not None else None
+        self.first_status = None
+        self.last_status = None
+        self.opus_data = bytearray(opus)
+        self.pcm_data = bytearray()
+        self.encrypted_data = bytearray()
+        self.page_timestamps = [{"absolute_timestamp_ms": 1760118000000 + i, "boot_uptime_ms": 0, "chunks": []}
+                                for i in range(len(indices))]
+        self.sent = []
+
+    def send_command(self, name, **kw):
+        self.sent.append((name, kw))
+
+    def run_with_timeout(self, seconds):
+        pass
+
+
+def test_saves_file_then_frees_through_contiguous_end(tmp_path):
+    c = FakeClient([100, 101, 102])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert list(tmp_path.glob("pendant_*.opus"))
+    assert c.sent == [("delete_flash_page", {"index": 102})]
+
+
+def test_gap_limits_deletion(tmp_path):
+    c = FakeClient([100, 101, 103])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 101})]
+
+
+def test_no_delete_without_flag(tmp_path):
+    c = FakeClient([100, 101])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=False)
+    assert c.sent == []
+
+
+def test_nothing_downloaded_deletes_nothing(tmp_path):
+    c = FakeClient([], opus=b"")
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_failed_save_deletes_nothing(tmp_path, monkeypatch):
+    from pathlib import Path
+    c = FakeClient([1, 2, 3])
+    real = Path.write_bytes
+    monkeypatch.setattr(Path, "write_bytes", lambda self, data: real(self, b""))  # simulate an empty write
+    with pytest.raises(click.ClickException):
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_health_file_written_next_to_archive(tmp_path):
+    from pendant.commands.audio import write_health
+    incoming = tmp_path / ".incoming"
+    incoming.mkdir()
+    c = FakeClient([1, 2, 3])
+    c.last_battery = {"level": 37, "charging": False}
+    c.last_status = {"storage_used_percent": 0.8, "recording_label": "listening"}
+    write_health(c, incoming)
+    import json as _json
+    h = _json.loads((tmp_path / "pendant-health.json").read_text())
+    assert h["pages_pulled"] == 3 and h["battery_percent"] == 37 and h["storage_used_percent"] == 0.8
+    assert h["recording"] == "listening" and "last_sync" in h
+    assert not (incoming / "pendant-health.json").exists()
+
+
+def test_health_file_without_status(tmp_path):
+    from pendant.commands.audio import write_health
+    c = FakeClient([])
+    c.last_battery = None
+    c.last_status = None
+    write_health(c, tmp_path)
+    import json as _json
+    h = _json.loads((tmp_path / "pendant-health.json").read_text())
+    assert h["battery_percent"] is None and h["pages_pulled"] == 0
+
+
+def test_health_asks_bluetooth_for_battery_when_pendant_did_not_say(tmp_path, monkeypatch):
+    from pendant.commands.audio import write_health
+    import pendant.core.dbus_client as dc
+    monkeypatch.setattr(dc, "get_battery_from_dbus", lambda address: 42)
+    c = FakeClient([1])
+    c.last_battery = None
+    c.last_status = {"storage_used_percent": 1.5, "recording_label": "listening"}
+    write_health(c, tmp_path, "AA:BB:CC:DD:EE:FF")
+    import json as _json
+    assert _json.loads((tmp_path / "pendant-health.json").read_text())["battery_percent"] == 42
+
+
+def test_delete_refused_when_download_did_not_start_at_oldest_page(tmp_path):
+    c = FakeClient([105, 106, 107], oldest=100)
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_delete_allowed_when_download_starts_at_oldest_page(tmp_path):
+    c = FakeClient([100, 101, 102], oldest=100)
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 102})]
+
+
+def test_unreadable_page_stops_deletion_before_it(tmp_path):
+    c = FakeClient([100, 101, 102, 103], oldest=100, bad=[102])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 101})]
+
+
+def test_unreadable_first_page_deletes_nothing(tmp_path):
+    c = FakeClient([100, 101], oldest=100, bad=[100])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_safe_delete_index_rules():
+    assert safe_delete_index([5, 6, 7], oldest_on_pendant=5) == 7
+    assert safe_delete_index([5, 6, 7], oldest_on_pendant=3) is None
+    assert safe_delete_index([5, 6, 7], bad_indices=[6]) == 5
+    assert safe_delete_index([5, 6, 7], bad_indices=[5]) is None
+    assert safe_delete_index([5, 6, 8, 9], bad_indices=[9]) == 6
+
+
+def test_real_pendant_reports_blank_oldest_page(tmp_path):
+    """What the pendant actually sent on Oct 10: device info oldest=0/newest=0 (not reported),
+    156 pages held, download 5162-5326 (165 pages, some recorded during the download)."""
+    c = FakeClient(range(5162, 5327))
+    c.device_info = {"oldest_flash_page": 0, "newest_flash_page": 0}
+    c.first_status = {"storage_used_pages": 156, "oldest_flash_page": 0, "newest_flash_page": 0}
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []  # oldest page unreported: coverage can't be proven, keep everything
+
+
+def test_real_pendant_after_fix(tmp_path):
+    """Oct 10, 16:31: storage status reported oldest 5162, 1931 pages; download 5162-7133."""
+    c = FakeClient(range(5162, 7134))
+    c.device_info = {"oldest_flash_page": 0, "newest_flash_page": 0}
+    c.first_status = {"storage_used_pages": 1931, "oldest_flash_page": 5162, "newest_flash_page": 7092}
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 7133})]
+
+
+def test_count_alone_never_allows_deletion(tmp_path):
+    """Brief case: count 3, oldest unknown, got 101-103 (page 100 may be missing)."""
+    c = FakeClient([101, 102, 103], oldest=None)
+    c.first_status = {"storage_used_pages": 3}
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_no_oldest_and_no_count_deletes_nothing(tmp_path):
+    c = FakeClient([101, 102], oldest=None)
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_oldest_page_from_storage_status(tmp_path):
+    c = FakeClient(range(5170, 5200))
+    c.first_status = {"storage_used_pages": 20, "oldest_flash_page": 5162, "newest_flash_page": 5190}
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []  # pendant says it starts at 5162; we started at 5170
+
+
+def test_too_few_pages_for_what_the_pendant_held(tmp_path):
+    c = FakeClient(range(5162, 5200), oldest=5162)  # 38 pages
+    c.first_status = {"storage_used_pages": 156, "oldest_flash_page": 5162, "newest_flash_page": 5300}
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
