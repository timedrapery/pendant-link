+def parse_export(text: str) -> bytes:
+    """The .tar.gz inside an export, checked against its sha256. Raises ValueError."""
+    import base64
+    import binascii
+    import hashlib
+    if BEGIN not in text or END not in text:
+        raise ValueError("no PENDANT KEYS block found (it starts with %s)" % BEGIN)
+    body = text.split(BEGIN, 1)[1].split(END, 1)[0]
+    want, data = None, []
+    for line in body.splitlines():
+        line = line.strip()
+        if line.startswith("sha256:"):
+            want = line.split(":", 1)[1].strip()
+        elif line and ":" not in line:
+            data.append(line)
+    try:
+        blob = base64.b64decode("".join(data), validate=True)
+    except (binascii.Error, ValueError):
+        raise ValueError("the block is damaged (not valid base64); copy it again in full")
+    if not want or hashlib.sha256(blob).hexdigest() != want:
+        raise ValueError("the block doesn't match its checksum; it was changed or cut short. Copy it again in full")
+    return blob
