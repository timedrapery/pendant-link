+def safe_delete_index(page_indices, bad_indices=(), oldest_on_pendant=None, settled_bad=()) -> Optional[int]:
+    """Highest page index that can be deleted without losing anything, or None.
+
+    The pendant's delete command removes every page at or below an index, so:
+    - only delete through the end of the unbroken run of pages we received;
+    - that run must start at the pendant's own oldest page (if we know it), or
+      pages before our first one would be deleted unseen;
+    - stop before any page the pendant flagged as unreadable, so it stays for
+      another try -- unless it's in settled_bad: unreadable in several separate
+      downloads, with what the pendant sent for it saved here.
+    """
+    indices = sorted(set(page_indices))
+    if not indices:
+        return None
+    if oldest_on_pendant is not None and indices[0] != oldest_on_pendant:
+        return None  # we didn't start at the beginning; delete nothing
+    bad = set(bad_indices) - set(settled_bad)
+    end = None
+    for i in indices:
+        if i in bad or (end is not None and i != end + 1):
+            break
+        end = i
+    return end
 
