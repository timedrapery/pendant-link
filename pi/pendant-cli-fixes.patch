+def test_wrong_key_keeps_chunks_whole(pendant_and_keys):
+    _, _, key = pendant_and_keys
+    proto = PendantProtocol()
+    opus, _, enc, _, _ = proto.extract_audio_from_flash_page(_page(key, [b"secret"]), os.urandom(16))
+    assert opus == b""
+    assert len(proto.undecrypted) == 1
+    rec = proto.undecrypted[0]
+    assert set(rec) >= {"nonce", "ciphertext", "tag"}
+
+
+def test_no_key_keeps_chunks_whole(pendant_and_keys):
+    _, _, key = pendant_and_keys
+    proto = PendantProtocol()
+    proto.extract_audio_from_flash_page(_page(key, [b"a", b"b"]), None)
+    assert len(proto.undecrypted) == 2
+
+
+def test_undecryptable_audio_is_never_freed(tmp_path, pendant_and_keys):
+    _, _, key = pendant_and_keys
+    c = FakeClient([100, 101, 102], opus=b"")
+    c.protocol = PendantProtocol()
+    c.protocol.extract_audio_from_flash_page(_page(key, [b"x" * 40]), None)
+    c.encrypted_data = bytearray(b"x")
+    c.private_key = None
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []  # nothing deleted
+    saved = list(tmp_path.glob("*.enc.jsonl"))
+    assert len(saved) == 1
+
+
+def test_saved_chunks_decrypt_later(tmp_path, pendant_and_keys, monkeypatch):
+    _, _, key = pendant_and_keys
+    proto = PendantProtocol()
+    proto.extract_audio_from_flash_page(_page(key, [b"first ", b"second"]), None)
+    enc = tmp_path / "pendant_20261010_120000.enc.jsonl"
+    enc.write_text("".join(json.dumps(r) + "\n" for r in proto.undecrypted))
+    result = CliRunner().invoke(decrypt, [str(enc), "--key", str(tmp_path / audiocrypto.AUDIO_KEY_FILE)])
+    assert result.exit_code == 0, result.output
+    assert (tmp_path / "pendant_20261010_120000.opus").read_bytes() == b"first second"
+
+
+def test_set_key_command_sends_raw_public_key(pendant_and_keys):
+    _, ours_raw, _ = pendant_and_keys
+    proto = PendantProtocol()
+    env = pb.BLEMessageFromNativeToPendant()
+    env.ParseFromString(proto.create_command("set_server_public_key", public_key=ours_raw))
+    cmd = pb.ServerCommandMsg()
+    cmd.ParseFromString(env.payload)
+    assert cmd.WhichOneof("content") == "set_audio_encryption_server_public_key"
+    assert cmd.set_audio_encryption_server_public_key.public_key == ours_raw
+    assert cmd.request_data.request_id == proto.message_index
+
+
+def _reply(error=None):
+    msg = pb.PendantAllMsg()
+    msg.response_data.request_id = 7
+    if error:
+        msg.response_data.error.category = 2
+        msg.response_data.error.error_message = error
+    return msg.SerializeToString()
+
+
+def test_reply_success_and_error():
+    proto = PendantProtocol()
+    ok = proto.parse_response(_reply())
+    assert ok["request_id"] == 7 and ok["response_success"] is True
+    bad = proto.parse_response(_reply("bad key"))
+    assert bad["response_success"] is False and bad["response_error"] == "bad key"
+
+
+def test_encrypted_bytes_wire_layout_matches_app():
+    """Field 1 nonce, 2 ciphertext, 3 tag, 4 packet offsets (FlashPageProto$EncryptedBytes)."""
+    e = pb.EncryptedBytes(nonce=b"N" * 12, ciphertext=b"C" * 5, tag=b"T" * 16, packet_offsets=[0, 3])
+    raw = e.SerializeToString()
+    assert raw.startswith(b"\x0a\x0c" + b"N" * 12 + b"\x12\x05" + b"C" * 5 + b"\x1a\x10" + b"T" * 16)
+    assert raw.endswith(b"\x22\x02\x00\x03")  # packed repeated int32
+
+
+def test_recovers_file_saved_with_swapped_fields(tmp_path, pendant_and_keys):
+    _, _, key = pendant_and_keys
+    lines = []
+    for pt in (b"one ", b"two"):
+        nonce = os.urandom(12)
+        ct, tag = audiocrypto.encrypt_chunk(key, nonce, pt)
+        # how the old version saved it: names swapped, no "layout"
+        lines.append(json.dumps({"page_index": 1, "nonce": ct.hex(), "ciphertext": nonce.hex(), "tag": tag.hex()}))
+    enc = tmp_path / "pendant_20261010_125315.enc.jsonl"
+    enc.write_text("\n".join(lines) + "\n")
+    result = CliRunner().invoke(decrypt, [str(enc), "--key", str(tmp_path / audiocrypto.AUDIO_KEY_FILE)])
+    assert result.exit_code == 0, result.output
+    assert (tmp_path / "pendant_20261010_125315.opus").read_bytes() == b"one two"
+
+
+def test_button_presses_come_through_with_their_time():
+    page = pb.FlashPage(absolute_timestamp_ms=1760125000000)
+    c = page.chunks.add(time_offset_ms=1500)
+    c.button_status.button_event = 1  # short press
+    c.button_status.button_event_absolute_timestamp_ms = 1760125001234
+    c2 = page.chunks.add(time_offset_ms=2000)
+    c2.button_status.button_event = 2  # long press, no own timestamp
+    c3 = page.chunks.add(time_offset_ms=2500)
+    c3.button_status.button_event = 0  # release: ignored
+    _, _, _, _, info = PendantProtocol().extract_audio_from_flash_page(page.SerializeToString())
+    assert info["buttons"] == [
+        {"event": "short press", "at_ms": 1760125001234},
+        {"event": "long press", "at_ms": 1760125002000},
+    ]
+
+
+def test_stars_saved_in_metadata(tmp_path):
+    c = FakeClient([5, 6], opus=b"\x01" * 10)
+    c.page_timestamps[1]["buttons"] = [{"event": "short press", "at_ms": 1760125001234},
+                                      {"event": "long press", "at_ms": 1760125009999}]
+    c.protocol = PendantProtocol()
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=False)
+    meta = json.loads(next(tmp_path.glob("*.json")).read_text())
+    assert meta["stars_ms"] == [1760125001234]
+    assert len(meta["button_events"]) == 2
+
+
+def test_timeline_follows_the_clock_across_gaps():
+    from pendant.core.protocol import build_timeline
+    t0 = 1760125000000  # first stretch of speech
+    t1 = t0 + 5 * 60_000  # second stretch, 5 minutes later
+    pages = [
+        {"absolute_timestamp_ms": t0, "audio_offset_bytes": 0,
+         "chunks": [{"time_offset_ms": 0, "audio_offset_bytes": 0},
+                    {"time_offset_ms": 1000, "audio_offset_bytes": 400}]},
+        {"absolute_timestamp_ms": t1, "audio_offset_bytes": 800,
+         "chunks": [{"time_offset_ms": 0, "audio_offset_bytes": 0}]},
+    ]
+    # 40-byte frames of 320 samples (20 ms): 20 frames per page-half
+    frame_map = [(i * 40, i * 320) for i in range(40)]
+    assert build_timeline(pages, frame_map) == [[0.0, t0], [0.2, t0 + 1000], [0.4, t1]]
+
+
+def test_timeline_skips_unsynced_pages():
+    from pendant.core.protocol import build_timeline
+    pages = [{"absolute_timestamp_ms": 12345, "audio_offset_bytes": 0, "chunks": [{"time_offset_ms": 0}]}]
+    assert build_timeline(pages, [(0, 0)]) == []
+
+
+def test_garbled_page_is_marked_unreadable():
+    proto = PendantProtocol()
+    _, _, _, _, info = proto.extract_audio_from_flash_page(b"\xff\xfe\xfd garbage that is not a FlashPage")
+    assert info.get("parse_failed") is True
+
+
+def test_rotating_owner_key_on_same_pendant_keeps_old_recordings_readable(tmp_path):
+    """Record under key A, rotate to B on the same pendant, decrypt both."""
+    device = ec.generate_private_key(ec.SECP256R1())
+    dev_raw = _raw(device.public_key())
+    audiocrypto.generate_keypair(keys_dir=tmp_path)
+    key_a = audiocrypto.save_audio_key(dev_raw, keys_dir=tmp_path)
+    page_a = _page(key_a, [b"made with A"])
+    audiocrypto.generate_keypair(keys_dir=tmp_path, force=True)      # new owner key, same pendant
+    key_b = audiocrypto.save_audio_key(dev_raw, keys_dir=tmp_path)
+    assert key_a != key_b
+    page_b = _page(key_b, [b"made with B"])
+    keys = audiocrypto.load_all_audio_keys(keys_dir=tmp_path)
+    assert keys[0] == key_b and key_a in keys
+    proto = PendantProtocol()
+    assert proto.extract_audio_from_flash_page(page_a, keys)[0] == b"made with A"
+    assert proto.extract_audio_from_flash_page(page_b, keys)[0] == b"made with B"
+    assert proto.undecrypted == []
+
+
+def test_same_key_again_makes_no_extra_generation(tmp_path, pendant_and_keys):
+    device, _, key = pendant_and_keys
+    again = audiocrypto.save_audio_key(_raw(device.public_key()), keys_dir=tmp_path)
+    assert again == key
+    assert not (tmp_path / "previous").exists()
+
+
+def test_key_id_is_short_and_not_the_key(pendant_and_keys):
+    _, _, key = pendant_and_keys
+    kid = audiocrypto.key_id(key)
+    assert len(kid) == 12 and key.hex()[:12] != kid
