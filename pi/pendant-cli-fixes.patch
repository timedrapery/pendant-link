 DEBUG_MODE = False
 
 
+RECORDING_STATE_LABELS = {0: "not recording", 1: "recording", 2: "listening (records when it hears speech)"}
+BUTTON_EVENT_LABELS = {0: "released", 1: "short press", 2: "long press", 3: "double press", 4: "short + super-long press"}
+WIFI_STATE_LABELS = {0: "disconnected", 1: "connecting", 2: "connected", 3: "init error"}
+
+
+def _status_dict(status) -> dict:
+    """Flatten a DeviceStatus message (field layout from the Limitless Android app)."""
+    out = {"is_recording": False, "recording_state": None, "recording_label": "unknown",
+           "storage_used_percent": 0.0, "storage_used_pages": None, "storage_total_pages": None,
+           "wifi_connected": False, "wifi_label": "unknown"}
+    if status.HasField("recording_status"):
+        state = status.recording_status.recording_state
+        out["recording_state"] = state
+        out["recording_label"] = RECORDING_STATE_LABELS.get(state, f"state {state}")
+        out["is_recording"] = state == 1
+    if status.HasField("storage_state"):
+        total = status.storage_state.total_capture_pages
+        free = status.storage_state.free_capture_pages
+        if total > 0:
+            used = max(total - free, 0)
+            out["storage_used_pages"] = used
+            out["storage_total_pages"] = total
+            out["storage_used_percent"] = round(used / total * 100, 1)
+    if status.HasField("wifi_status"):
+        w = status.wifi_status.state
+        out["wifi_connected"] = w == 2
+        out["wifi_label"] = WIFI_STATE_LABELS.get(w, f"state {w}")
+    return out
+
+
