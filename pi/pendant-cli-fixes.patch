+        lines.append(f"  Flash pages: oldest {info['oldest_flash_page']}, newest {info['newest_flash_page']}")
+    lines.append(f"  Device public key: {'present' if info.get('has_device_public_key') else 'none'} "
+                 "(the pendant's own key; it doesn't mean recordings are encrypted)")
+    if info.get("status"):
+        lines.extend(format_status_lines(info["status"]))
+    return lines
