+"""Audio encryption: the Limitless app's scheme, and never freeing what we can't read."""
+
+import json
+import os
+
+import pytest
+from click.testing import CliRunner
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.hazmat.primitives.kdf.hkdf import HKDF
+
+from pendant.core import audiocrypto
+from pendant.core.protocol import PendantProtocol, pb
+from pendant.commands.audio import _save_and_free
+from pendant.commands.crypto import decrypt
+
+from test_sync_safety import FakeClient
+
+
+def _raw(pub):
+    return pub.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
+
+
+@pytest.fixture
+def pendant_and_keys(tmp_path):
+    """A fake pendant key pair, plus our key pair and audio key in tmp_path."""
+    device = ec.generate_private_key(ec.SECP256R1())
+    ours_raw = audiocrypto.generate_keypair(keys_dir=tmp_path)
+    key = audiocrypto.save_audio_key(_raw(device.public_key()), keys_dir=tmp_path)
+    return device, ours_raw, key
+
+
+def _pendant_side_key(device, ours_raw):
+    """What the pendant computes from our public key."""
+    ours = ec.EllipticCurvePublicKey.from_encoded_point(ec.SECP256R1(), ours_raw)
+    shared = device.exchange(ec.ECDH(), ours)
+    return HKDF(algorithm=hashes.SHA256(), length=16, salt=None, info=b"").derive(shared)
+
+
+def test_both_sides_derive_the_same_key(pendant_and_keys):
+    device, ours_raw, key = pendant_and_keys
+    assert len(ours_raw) == 65 and ours_raw[0] == 0x04
+    assert len(key) == 16
+    # salt=None (RFC 5869 zeros) must equal the app's empty salt
+    assert _pendant_side_key(device, ours_raw) == key
+
+
+def test_key_files_are_private(tmp_path, pendant_and_keys):
+    for name in (audiocrypto.PRIVATE_FILE, audiocrypto.AUDIO_KEY_FILE):
+        assert oct((tmp_path / name).stat().st_mode & 0o777) == "0o600"
+    assert audiocrypto.load_audio_key(keys_dir=tmp_path) == pendant_and_keys[2]
+
+
+def test_keygen_wont_overwrite(tmp_path, pendant_and_keys):
+    with pytest.raises(FileExistsError):
+        audiocrypto.generate_keypair(keys_dir=tmp_path)
+
+
+def test_rejects_wrong_kind_of_device_key():
+    with pytest.raises(ValueError):
+        audiocrypto.parse_device_public_key(os.urandom(32))  # an X25519-sized key
+    with pytest.raises(ValueError):
+        audiocrypto.parse_device_public_key(b"\x04" + b"\x00" * 64)  # not on the curve
+
+
+def _page(key, chunks):
+    page = pb.FlashPage(absolute_timestamp_ms=1760118000000)
+    for plaintext in chunks:
+        nonce = os.urandom(12)
+        ct, tag = audiocrypto.encrypt_chunk(key, nonce, plaintext)
+        c = page.chunks.add()
+        c.audio_data.encrypted_codec_beamforming_data.ciphertext = ct
+        c.audio_data.encrypted_codec_beamforming_data.nonce = nonce
+        c.audio_data.encrypted_codec_beamforming_data.tag = tag
+    return page.SerializeToString()
+
+
+def test_decrypts_pendant_audio(pendant_and_keys):
+    _, _, key = pendant_and_keys
+    proto = PendantProtocol()
+    opus, _, enc, _, _ = proto.extract_audio_from_flash_page(_page(key, [b"hello ", b"world"]), key)
+    assert opus == b"hello world"
+    assert enc == b"" and proto.undecrypted == []
