+def test_sessions_saved_in_metadata(tmp_path, capsys):
+    import json
+    c = bad_client([10, 11, 12], bad=[10])
+    c.page_sessions = [(10, 7, 0, True), (11, 8, 0, False), (12, 8, 1, False)]
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=False)
+    meta = json.loads(next(tmp_path.glob("*.json")).read_text())
+    assert [s["session"] for s in meta["sessions"]] == [7, 8]
+    assert meta["sessions"][1]["runs"] == [0, 1]
+    assert "Session 7: pages 10-10, 1 received, 1 unreadable" in capsys.readouterr().out
