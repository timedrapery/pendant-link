--- /dev/null
+++ b/tests/test_key_export.py
@@ -0,0 +1,86 @@
+"""pendant crypto export / import: keys to a password manager and back, intact."""
+import os
+
+import pytest
+
+from pendant.commands import crypto
+from pendant.core import audiocrypto
+
+
+def make_keys(d):
+    if not (d / audiocrypto.PRIVATE_FILE).exists():
+        audiocrypto.generate_keypair(d)
+    from cryptography.hazmat.primitives.asymmetric import ec
+    from cryptography.hazmat.primitives import serialization
+    dev = ec.generate_private_key(ec.SECP256R1()).public_key().public_bytes(
+        serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
+    audiocrypto.save_audio_key(dev, d)
+    (d / "backup-crypt.txt").write_text("password=abc\npassword2=def\n")
+    return audiocrypto.load_audio_key(d)
+
+
+def test_round_trip_to_a_new_pi(tmp_path):
+    old, new = tmp_path / "old", tmp_path / "new"
+    key = make_keys(old)
+    text = crypto.export_text(old)
+    assert text.startswith(crypto.BEGIN) and "audio key id: " + audiocrypto.key_id(key) in text
+    written = crypto.import_archive(crypto.parse_export("my vault notes\n" + text + "\nmore notes"), new)
+    assert set(written) >= {"audio.key", "server_private.pem", "backup-crypt.txt"}
+    for name in written:
+        assert (new / name).read_bytes() == (old / name).read_bytes()
+        assert os.stat(new / name).st_mode & 0o777 == 0o600
+    assert os.stat(new).st_mode & 0o777 == 0o700
+
+
+def test_damaged_block_is_refused(tmp_path):
+    make_keys(tmp_path / "k")
+    text = crypto.export_text(tmp_path / "k")
+    lines = text.splitlines()
+    i = next(n for n, l in enumerate(lines) if l and ":" not in l and not l.startswith("-----"))
+    lines[i] = ("B" if lines[i][0] != "B" else "C") + lines[i][1:]
+    with pytest.raises(ValueError, match="checksum|damaged"):
+        crypto.parse_export("\n".join(lines))
+    with pytest.raises(ValueError, match="checksum"):
+        crypto.parse_export("\n".join(l for l in text.splitlines() if l != lines[i + 1]))   # a line lost in copying
+    with pytest.raises(ValueError, match="no PENDANT KEYS"):
+        crypto.parse_export("hello")
+
+
+def test_never_overwrites_different_keys_without_force(tmp_path):
+    a, b = tmp_path / "a", tmp_path / "b"
+    make_keys(a)
+    other = make_keys(b)
+    blob = crypto.parse_export(crypto.export_text(a))
+    with pytest.raises(FileExistsError):
+        crypto.import_archive(blob, b)
+    assert audiocrypto.load_audio_key(b) == other            # untouched
+    crypto.import_archive(blob, b, force=True)
+    assert audiocrypto.load_audio_key(b) == audiocrypto.load_audio_key(a)
+    assert other in audiocrypto.load_all_audio_keys(b)        # the replaced key kept in previous/
+
+
+def test_same_keys_import_again_is_fine(tmp_path):
+    a = tmp_path / "a"
+    make_keys(a)
+    blob = crypto.parse_export(crypto.export_text(a))
+    crypto.import_archive(blob, a)                            # nothing different: no error
+
+
+def test_earlier_generations_travel_too(tmp_path):
+    a, b = tmp_path / "a", tmp_path / "b"
+    first = make_keys(a)
+    make_keys(a)                                              # setkey with a reset pendant: first kept in previous/
+    crypto.import_archive(crypto.parse_export(crypto.export_text(a)), b)
+    assert first in audiocrypto.load_all_audio_keys(b)
+
+
+def test_unsafe_archive_entries_refused(tmp_path):
+    import io, tarfile
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
+        info = tarfile.TarInfo("../escape")
+        info.size = 1
+        tar.addfile(info, io.BytesIO(b"x"))
+    with pytest.raises(ValueError, match="unexpected"):
+        crypto.import_archive(buf.getvalue(), tmp_path / "k")
+    assert not (tmp_path / "escape").exists()
