+def _keys_archive(d: Path) -> bytes:
+    """Every regular file in the keys folder (and earlier generations), as a .tar.gz."""
+    import io
+    import tarfile
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
+        for f in sorted(d.rglob("*")):
+            if f.is_file() and not f.is_symlink():
+                info = tarfile.TarInfo(str(f.relative_to(d)))
+                data = f.read_bytes()
+                info.size, info.mode, info.mtime = len(data), 0o600, int(f.stat().st_mtime)
+                tar.addfile(info, io.BytesIO(data))
+    return buf.getvalue()
+
