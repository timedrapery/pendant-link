+def format_device_info_lines(info: dict) -> list:
+    """Human-readable lines for a decoded DeviceInfoMsg."""
+    lines = [f"  Firmware: {info.get('firmware_version') or '?'}"]
+    if info.get("serial_number"):  # the pendant often leaves this blank
+        lines.append(f"  Serial: {info['serial_number']}")
+    lines.append(f"  Device ID: {info.get('device_id', '?')}")
+    if info.get("ble_mac_address"):
