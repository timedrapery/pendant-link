+"""`pendant sync` hands off to the installed sync script."""
+
+import os
+import stat
+
+from click.testing import CliRunner
+
+from pendant.cli import cli
+
+
+def test_sync_missing_script(tmp_path, monkeypatch):
+    monkeypatch.setenv("PENDANT_SYNC_SCRIPT", str(tmp_path / "nope"))
+    result = CliRunner().invoke(cli, ["sync"])
+    assert result.exit_code != 0
+    assert "isn't installed" in result.output
+
+
+def test_sync_runs_script_with_address(tmp_path, monkeypatch):
+    script = tmp_path / "pendant-sync"
+    script.write_text("#!/bin/sh\n")
+    script.chmod(script.stat().st_mode | stat.S_IEXEC)
+    monkeypatch.setenv("PENDANT_SYNC_SCRIPT", str(script))
+    calls = []
+    monkeypatch.setattr(os, "execve", lambda path, argv, env: calls.append((path, env)))
+    result = CliRunner().invoke(cli, ["-a", "C2:72:BC:F1:88:3F", "sync"])
+    assert result.exit_code == 0, result.output
+    assert calls[0][0] == str(script)
+    assert calls[0][1]["PENDANT_ADDRESS"] == "C2:72:BC:F1:88:3F"
