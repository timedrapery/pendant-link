+def format_status_lines(st: dict) -> list:
+    """Human-readable lines for a flattened DeviceStatus."""
+    lines = []
+    if st.get("recording_state") is not None:
+        lines.append(f"  Recording: {st['recording_label']}")
+    used, total = st.get("storage_used_pages"), st.get("storage_total_pages")
+    if used is not None and total:
+        lines.append(f"  Storage: {used} of {total} pages used ({st.get('storage_used_percent', 0)}%)")
+    else:
+        lines.append("  Storage: unknown")
+    if st.get("wifi_label") not in (None, "unknown"):
+        lines.append(f"  Wi-Fi: {st['wifi_label']}")
+    return lines
+
+
+def format_device_info_lines(info: dict) -> list:
+    """Human-readable lines for a decoded DeviceInfoMsg."""
+    lines = [
+        f"  Firmware: {info.get('firmware_version') or '?'}",
+        f"  Serial: {info.get('serial_number') or '?'}",
+        f"  Device ID: {info.get('device_id', '?')}",
+    ]
+    if info.get("ble_mac_address"):
+        lines.append(f"  Bluetooth address: {info['ble_mac_address']}")
+    if info.get("battery_percent"):
+        lines.append(f"  Battery: {info['battery_percent']}%")
+    if info.get("oldest_flash_page") or info.get("newest_flash_page"):
+        lines.append(f"  Flash pages: oldest {info['oldest_flash_page']}, newest {info['newest_flash_page']}")
+    lines.append(f"  Device public key: {'present' if info.get('has_device_public_key') else 'none'} "
+                 "(the pendant's own key; it doesn't mean recordings are encrypted)")
+    if info.get("status"):
+        lines.extend(format_status_lines(info["status"]))
+    return lines
+
