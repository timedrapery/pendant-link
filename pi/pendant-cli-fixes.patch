+++ b/tests/test_durable_save.py
@@ -0,0 +1,74 @@
+"""Nothing is freed on the pendant unless every saved file is on disk exactly as downloaded."""
+from pathlib import Path
+
+import click
+import pytest
+
+from pendant.commands import audio
+from pendant.commands.audio import _save_and_free, verify_saved
+from test_sync_safety import FakeClient
+
+
+def test_frees_after_files_are_verified(tmp_path, capsys):
+    c = FakeClient([100, 101, 102])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 102})]
+    assert "identical to the download" in capsys.readouterr().out
+
+
+def test_altered_on_write_frees_nothing(tmp_path, monkeypatch):
+    real = Path.write_bytes
+    monkeypatch.setattr(Path, "write_bytes", lambda self, data: real(self, bytes(data[:-1]) + b"X"))
+    c = FakeClient([1, 2, 3])
+    with pytest.raises(click.ClickException, match="don't match"):
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_file_gone_before_freeing_frees_nothing(tmp_path, monkeypatch):
+    real = audio.verify_saved
+
+    def vanish_then_verify(expected):
+        for p in expected:
+            if p.suffix == ".opus":
+                p.unlink()
+        return real(expected)
+
+    monkeypatch.setattr(audio, "verify_saved", vanish_then_verify)
+    c = FakeClient([1, 2, 3])
+    with pytest.raises(click.ClickException):
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_metadata_is_checked_too(tmp_path, monkeypatch):
+    real = audio.verify_saved
+
+    def damage_json(expected):
+        for p in expected:
+            if p.suffix == ".json":
+                p.write_text("{}")
+        return real(expected)
+
+    monkeypatch.setattr(audio, "verify_saved", damage_json)
+    c = FakeClient([1, 2, 3])
+    with pytest.raises(click.ClickException):
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []
+
+
+def test_verify_saved_reports_each_problem(tmp_path):
+    a, b = tmp_path / "a.opus", tmp_path / "b.json"
+    a.write_bytes(b"abc")
+    b.write_bytes(b"{}")
+    exp = {a: (3, audio._sha256(b"abc")), b: (2, audio._sha256(b"[]"))}
+    problems = verify_saved(exp)
+    assert len(problems) == 1 and "b.json" in problems[0]
+    a.unlink()
+    assert len(verify_saved(exp)) == 2
+
+
+def test_no_flag_writes_but_does_not_need_verifying(tmp_path):
+    c = FakeClient([1, 2])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=False)
+    assert c.sent == [] and list(tmp_path.glob("*.opus"))
