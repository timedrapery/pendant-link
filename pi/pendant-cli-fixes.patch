@@ -0,0 +1,231 @@
+"""A page the pendant can't read must not stop freeing for good (Oct 10: pages 6055-6473)."""
+import json
+
+from pendant.commands.audio import _save_and_free, write_health
+from pendant.core.protocol import safe_delete_index
+from test_sync_safety import FakeClient
+
+
+def bad_client(indices, bad, oldest=None, held=None):
+    c = FakeClient(indices, oldest=oldest if oldest is not None else min(indices), bad=bad)
+    c.bad_pages = {i: {"index": i, "why": "pendant reported error 1", "error": 1,
+                       "session": 1, "seq": i, "flash_page": "0a0b"} for i in bad}
+    if held is not None:
+        c.first_status = {"storage_used_pages": held, "oldest_flash_page": min(indices),
+                          "newest_flash_page": max(indices)}
+    return c
+
+
+def test_settled_bad_pages_can_be_passed():
+    assert safe_delete_index([5, 6, 7], bad_indices=[5]) is None
+    assert safe_delete_index([5, 6, 7], bad_indices=[5], settled_bad=[5]) == 7
+    assert safe_delete_index([5, 6, 7, 8], bad_indices=[6, 8], settled_bad=[6]) == 7
+
+
+def test_unreadable_first_page_is_passed_after_three_downloads(tmp_path):
+    for attempt in (1, 2):
+        c = bad_client([100, 101, 102, 103], bad=[100])
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+        assert c.sent == [], f"attempt {attempt} must not free"
+    c = bad_client([100, 101, 102, 103], bad=[100])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 103})]
+    saved = list(tmp_path.glob("*.badpages.jsonl"))
+    assert saved
+    rec = json.loads(saved[0].read_text().splitlines()[0])
+    assert rec["index"] == 100 and rec["flash_page"] == "0a0b"
+
+
+def test_oct_10_pendant_frees_on_the_third_sync(tmp_path):
+    bad = list(range(6055, 6474))
+    results = []
+    for _ in range(3):
+        c = bad_client(range(6055, 19008), bad=bad, held=12953)
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+        results.append(c.sent)
+    assert results == [[], [], [("delete_flash_page", {"index": 19007})]]
+
+
+def test_page_that_reads_fine_later_starts_counting_again(tmp_path):
+    for _ in range(2):
+        _save_and_free(bad_client([1, 2, 3], bad=[1]), decode=False, output_dir=tmp_path, delete_after=True)
+    _save_and_free(bad_client([1, 2, 3], bad=[]), decode=False, output_dir=tmp_path, delete_after=False)
+    # a download without --delete-after doesn't count; one that read it fine does:
+    c = bad_client([1, 2, 3], bad=[])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 3})]
+    c = bad_client([1, 2, 3], bad=[1])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == []  # the count started over
+
+
+def test_unreadable_middle_page_passed_after_three_downloads(tmp_path):
+    for _ in range(2):
+        c = bad_client([10, 11, 12, 13], bad=[12])
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+        assert c.sent == [("delete_flash_page", {"index": 11})]
+    # in real use pages 10-11 are gone by now; the next download starts at 12,
+    # which then fails for the third time
+    c = bad_client([12, 13, 14], bad=[12])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 14})]
+
+
+def test_never_passed_without_its_bytes_saved(tmp_path):
+    for _ in range(4):
+        c = bad_client([1, 2, 3], bad=[1])
+        c.bad_pages = {}  # nothing kept for it
+        _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+        assert c.sent == []
+
+
+def test_tries_can_be_set(tmp_path, monkeypatch):
+    monkeypatch.setenv("PENDANT_BAD_PAGE_TRIES", "1")
+    c = bad_client([1, 2, 3], bad=[1])
+    _save_and_free(c, decode=False, output_dir=tmp_path, delete_after=True)
+    assert c.sent == [("delete_flash_page", {"index": 3})]
+
+
+def test_after_a_factory_reset_old_counts_are_dropped(tmp_path):
+    for _ in range(2):
+        _save_and_free(bad_client(range(6055, 6100), bad=[6055]), decode=False, output_dir=tmp_path, delete_after=True)
+    _save_and_free(bad_client([0, 1, 2], bad=[]), decode=False, output_dir=tmp_path, delete_after=True)
+    history = json.loads((tmp_path / ".unreadable-pages.json").read_text())
+    assert history["pages"] == {}
+
+
+def test_health_says_when_pages_could_not_be_freed(tmp_path):
+    inc = tmp_path / ".incoming"
+    inc.mkdir()
+    c = bad_client([1, 2, 3], bad=[1])
+    c.last_battery = {"level": 80}
+    freeing = _save_and_free(c, decode=False, output_dir=inc, delete_after=True)
+    write_health(c, inc, None, freeing)
+    h = json.loads((tmp_path / "pendant-health.json").read_text())
+    assert "unreadable" in h["not_freed_reason"]
+    assert h["unreadable_pages_waiting"] == 1
+    assert "last_freed" not in h
+
+    c = bad_client([1, 2, 3], bad=[])
+    c.last_battery = {"level": 80}
+    freeing = _save_and_free(c, decode=False, output_dir=inc, delete_after=True)
+    write_health(c, inc, None, freeing)
+    h = json.loads((tmp_path / "pendant-health.json").read_text())
+    assert h["not_freed_reason"] is None and h["last_freed"] == h["last_sync"]
+
+    empty = FakeClient([], opus=b"")
+    empty.last_battery = {"level": 79}
+    write_health(empty, inc, None, {"freed": False, "reason": None, "unreadable_pages_waiting": 0})
+    h2 = json.loads((tmp_path / "pendant-health.json").read_text())
+    assert h2["last_freed"] == h["last_freed"]  # a sync with nothing new keeps the last good free
+
+
+def test_client_keeps_what_the_pendant_sent_for_an_unreadable_page():
+    from pendant.core.dbus_client import DBusClient
+    c = DBusClient("AA:BB:CC:DD:EE:FF")
+    c._handle_response({"type": "storage_buffer", "index": 6055, "session": 2, "seq": 9,
+                        "flash_page": b"\x01\x02\xff", "error": 1})
+    c._handle_response({"type": "storage_buffer", "index": 6056, "session": 2, "seq": 10,
+                        "flash_page": b"\xff\xfe\xfd\xfc", "error": 0})  # garbled: won't parse
+    assert c.bad_page_indices[0] == 6055
+    assert c.bad_pages[6055]["flash_page"] == "0102ff" and c.bad_pages[6055]["error"] == 1
+    if 6056 in c.bad_page_indices:  # only when the bytes really don't parse as a page
+        assert c.bad_pages[6056]["flash_page"] == "fffefdfc"
+
+
+def test_disconnect_hangs_up_the_bluetooth_link(monkeypatch):
+    import sys, types
+    from pendant.core.dbus_client import DBusClient
+    calls = []
+
+    class FakeIface:
+        def __init__(self, obj, name):
+            self.name = name
+        def Disconnect(self):
+            calls.append(self.name)
+
+    fake_dbus = types.SimpleNamespace(Interface=FakeIface)
+    monkeypatch.setitem(sys.modules, "dbus", fake_dbus)
+    c = DBusClient("AA:BB:CC:DD:EE:FF")
+    c.bus = types.SimpleNamespace(get_object=lambda svc, path: (svc, path))
+    c.disconnect()
+    assert calls == ["org.bluez.Device1"]
+
+    calls.clear()
+    monkeypatch.setenv("PENDANT_STAY_CONNECTED", "yes")
+    c.disconnect()
+    assert calls == []
+
+
+def test_disconnect_switches_batch_mode_off_first(monkeypatch):
+    import sys, types
+    from pendant.core.dbus_client import DBusClient
+    from pendant.core.proto import pb
+    order = []
+
+    class Ctrl:
+        def WriteValue(self, value, opts):
+            env = pb.BLEMessageFromNativeToPendant()
+            env.ParseFromString(bytes(value))
+            cmd = pb.ServerCommandMsg()
+            cmd.ParseFromString(env.payload)
+            order.append(("write", cmd.WhichOneof("content"), cmd.download_flash_pages.batch_mode_enabled))
+
+    class Data:
+        def StopNotify(self):
+            order.append(("stop-notify",))
+
+    class FakeIface:
+        def __init__(self, obj, name):
+            pass
+        def Disconnect(self):
+            order.append(("hang-up",))
+
+    monkeypatch.setitem(sys.modules, "dbus", types.SimpleNamespace(Interface=FakeIface, Array=lambda v, signature=None: list(v)))
+    monkeypatch.setattr("time.sleep", lambda s: None)
+    c = DBusClient("AA:BB:CC:DD:EE:FF")
+    c.ctrl_char, c.data_char = Ctrl(), Data()
+    c.bus = types.SimpleNamespace(get_object=lambda svc, path: None)
+    c.disconnect()
+    assert order == [("write", "download_flash_pages", False), ("stop-notify",), ("hang-up",)]
+
+
+def test_status_shows_sync_mode():
+    from pendant.core.protocol import _status_dict, format_status_lines
+    from pendant.core.proto import pb
+    st = pb.DeviceStatus()
+    st.sync_mode = 1   # the app's PendantSyncMode.BLE_BATCH
+    lines = format_status_lines(_status_dict(st))
+    assert "  Sync mode: sending recordings (batch)" in lines
+    st.sync_mode = 2
+    assert "  Sync mode: real-time" in format_status_lines(_status_dict(st))
+    st.sync_mode = 0
+    assert "  Sync mode: off" in format_status_lines(_status_dict(st))
+
+
+def test_sessions_recorded_for_every_page(tmp_path):
+    import json
+    from pendant.core.dbus_client import DBusClient
+    c = DBusClient("AA:BB:CC:DD:EE:FF")
+    for i in range(3855, 3858):
+        c._handle_response({"type": "storage_buffer", "index": i, "session": 1147, "run": 0,
+                            "seq": i, "flash_page": b"", "error": 1})
+    for i in range(3858, 3860):
+        c._handle_response({"type": "storage_buffer", "index": i, "session": 1148, "run": 2,
+                            "seq": i, "flash_page": b"", "error": 0})
+    from pendant.commands.audio import session_summary
+    assert session_summary(c.page_sessions) == [
+        {"session": 1147, "runs": [0], "first_page": 3855, "last_page": 3857, "pages": 3, "unreadable": 3},
+        {"session": 1148, "runs": [2], "first_page": 3858, "last_page": 3859, "pages": 2, "unreadable": 0},
+    ]
