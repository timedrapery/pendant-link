#!/usr/bin/env bash
# Copy the recordings archive to Google Drive, encrypted on the Pi first (rclone crypt).
# Copies, never mirrors: deleting something here never deletes the backup.
# Skips .wav files (rebuild them with `pendant decode`), anything still in .incoming, and
# .replaced (copies set aside because a kept copy provably holds all of them).
# Run it as `pendant backup`; pendant-backup.timer does that every night.
# `pendant backup --check` copies nothing: it checks that every file here is in the backup
# and intact (rclone cryptcheck compares checksums through the encryption; nothing is downloaded).
set -euo pipefail

ARCHIVE="${PENDANT_ARCHIVE:-$HOME/recordings}"
REMOTE="${PENDANT_BACKUP_REMOTE:-pendant-backup:}"
TRANSCRIPTS_REMOTE="${PENDANT_TRANSCRIPTS_REMOTE:-gdrive:pendant-transcripts}"

# Settings saved in ~/.config/pendant/env; anything already set in the shell wins.
# PENDANT_TRANSCRIPTS_TO_DRIVE=yes also puts readable .txt transcripts (text only, never
# audio) in a pendant-transcripts folder on Drive, so Claude can read them. Google can too.
if [ -z "${PENDANT_TRANSCRIPTS_TO_DRIVE:-}" ] && [ -f "$HOME/.config/pendant/env" ]; then
  PENDANT_TRANSCRIPTS_TO_DRIVE=$(sed -n 's/^PENDANT_TRANSCRIPTS_TO_DRIVE=//p' "$HOME/.config/pendant/env" | tail -1)
fi
LOG="$ARCHIVE/backup.log"

mkdir -p "$ARCHIVE"
exec > >(tee -a "$LOG") 2>&1
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*"; }

SKIP=(--exclude ".incoming/**" --exclude ".replaced/**" --exclude ".filing-journal/**"
      --exclude "*.wav" --exclude "*.lock" --exclude "*.log" --exclude "*.tmp" --exclude "*.filing"
      --exclude "/.last-backup")
LAST="$ARCHIVE/.last-backup"   # when the last successful backup started (seconds since 1970)

if [ "${1:-}" = "--check" ]; then
  # Check only what the last backup should hold: files unchanged since it started. Newer
  # ones (this morning's recordings, the status files every sync rewrites) go up next time.
  AGE=()
  if START=$(cat "$LAST" 2>/dev/null) && [ -n "$START" ]; then
    AGE=(--min-age "$(( $(date +%s) - START ))s")
    log "Checking the backup against $ARCHIVE: everything as of the last backup, $(date -d "@$START" '+%Y-%m-%d %H:%M') (nothing is downloaded)"
    NEWER=$(find "$ARCHIVE" -type f -newermt "@$START" ! -path "*/.incoming/*" ! -path "*/.replaced/*" \
            ! -path "*/.filing-journal/*" ! -name "*.wav" ! -name "*.log" ! -name "*.lock" ! -name ".last-backup" | wc -l)
  else
    log "Checking the backup against everything in $ARCHIVE (no record of the last backup yet; nothing is downloaded)"
    NEWER=0
  fi
  if rclone cryptcheck "$ARCHIVE" "$REMOTE" --one-way "${SKIP[@]}" "${AGE[@]}" --checkers 4; then
    log "Backup check passed: every file as of the last backup is there, intact."
    [ "$NEWER" -gt 0 ] && log "  ($NEWER newer file(s) not checked; they go up with the next backup.)"
    exit 0
  fi
  log "Backup check found differences (listed above): those files are missing from the backup or don't match."
  log "  Run 'pendant backup' and check again; if they still differ, the backup needs a look."
  exit 1
fi

log "Backing up $ARCHIVE"
START=$(date +%s)
rclone copy "$ARCHIVE" "$REMOTE" \
  "${SKIP[@]}" \
  --transfers 2 --tpslimit 8 \
  --stats-one-line --stats 60s -v || { log "Backup failed; will try again tomorrow."; exit 1; }
log "Backup done."
echo "$START" > "$LAST.tmp" && mv "$LAST.tmp" "$LAST"

if [ "${PENDANT_TRANSCRIPTS_TO_DRIVE:-}" = "yes" ]; then
  log "Copying readable transcripts (text only) to $TRANSCRIPTS_REMOTE"
  rclone copy "$ARCHIVE" "$TRANSCRIPTS_REMOTE" \
    --filter "- .incoming/**" \
    --filter "+ */" \
    --filter "+ pendant_*.txt" \
    --filter "+ /pendant-health.json" \
    --filter "- *" \
    --tpslimit 8 \
    --stats-one-line --stats 60s -v || { log "Copying transcripts failed; will try again tomorrow."; exit 1; }
  log "Transcripts done."
fi
